{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "yarn typecheck && vite build",
    "lint": "eslint . --fix",
    "typecheck": "tsc && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "preview": "yarn build && vite preview",
    "postinstall": "husky .husky"
  },
  "dependencies": {
    "clsx": "^2.1.1",
